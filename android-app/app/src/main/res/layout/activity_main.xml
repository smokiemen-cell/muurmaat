<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/ar_fragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E6173F3A">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kies lengte en tik een beginpunt aan"
            android:textColor="#FFFDF8"
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/manual_length"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Lengte m"
                android:inputType="numberDecimal"
                android:textColor="#FFFDF8"
                android:textColorHint="#B1C0B6" />
            <EditText
                android:id="@+id/manual_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hoogte m"
                android:inputType="numberDecimal"
                android:textColor="#FFFDF8"
                android:textColorHint="#B1C0B6" />
            <Button
                android:id="@+id/manual_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/length_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lengte" />
            <Button
                android:id="@+id/height_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoogte" />
            <Button
                android:id="@+id/reset_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lengte: -   Hoogte: -   Zakken: -"
            android:textColor="#FFFDF8"
            android:textSize="18sp"
            android:paddingTop="12dp" />
    </LinearLayout>
</FrameLayout>
