<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/ar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/camera_hand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="☝"
        android:textSize="52sp"
        android:visibility="gone"
        android:alpha="0.9" />

    <FrameLayout
        android:id="@+id/camera_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <Button
            android:id="@+id/close_camera_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:backgroundTint="#C96F4A"
            android:textColor="#FFFDF8"
            android:text="Sluiten" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="20dp"
            android:text="CAMERA METEN"
            android:textColor="#FFFDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/manual_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#FFF4F0E8">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOUWCALCULATOR"
            android:textColor="#FFC96F4A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voegmaatje"
            android:textColor="#FF173F3A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maten, aantallen en prijzen zijn indicaties en kunnen afwijken van de werkelijkheid."
            android:textColor="#FF5D655D"
            android:textSize="12sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vul je muur in of kies camera"
            android:textColor="#FF173F3A"
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/manual_length"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Lengte m"
                android:inputType="numberDecimal"
                android:textColor="#FF173F3A"
                android:textColorHint="#FF847F73" />
            <EditText
                android:id="@+id/manual_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hoogte m"
                android:inputType="numberDecimal"
                android:textColor="#FF173F3A"
                android:textColorHint="#FF847F73" />
            <EditText
                android:id="@+id/manual_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Prijs €"
                android:inputType="numberDecimal"
                android:text="8,50"
                android:textColor="#FF173F3A"
                android:textColorHint="#FF847F73" />
            <Button
                android:id="@+id/manual_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/camera_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#173F3A"
                android:textColor="#FFFDF8"
                android:text="Meet met camera" />
            <Button
                android:id="@+id/average_price_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#E8DFCF"
                android:textColor="#173F3A"
                android:text="Gem. prijs" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/length_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#173F3A"
                android:textColor="#FFFDF8"
                android:text="Lengte" />
            <Button
                android:id="@+id/height_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#173F3A"
                android:textColor="#FFFDF8"
                android:text="Hoogte" />
            <Button
                android:id="@+id/reset_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#E8DFCF"
                android:textColor="#173F3A"
                android:text="Reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oppervlakte: -   Zakken: -   Totaal: -"
            android:textColor="#FFFDF8"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="#173F3A" />
    </LinearLayout>
</FrameLayout>
