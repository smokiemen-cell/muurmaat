<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stone_wall">

    <FrameLayout
        android:id="@+id/ar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/camera_hand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="☝"
        android:textSize="52sp"
        android:visibility="gone"
        android:alpha="0.9" />

    <FrameLayout
        android:id="@+id/camera_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <Button
            android:id="@+id/close_camera_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:backgroundTint="#C96F4A"
            android:textColor="#FFFDF8"
            android:text="Sluiten" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="20dp"
            android:text="CAMERA METEN"
            android:textColor="#FFFDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/manual_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="18dp"
        android:background="#E6FFFDF8">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOUWCALCULATOR"
            android:textColor="#C96F4A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/menu_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Menu" />

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welkom"
            android:textColor="#C96F4A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voegmaatje"
            android:textColor="#173F3A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maten, aantallen en prijzen zijn indicaties en kunnen afwijken van de werkelijkheid."
            android:textColor="#847F73"
            android:textSize="12sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vul je muur in of kies camera"
            android:textColor="#173F3A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/manual_length"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Lengte m"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"
                android:textColor="#173F3A"
                android:textColorHint="#847F73"
                android:backgroundTint="#D5CDBF" />
            <EditText
                android:id="@+id/manual_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hoogte m"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"
                android:textColor="#173F3A"
                android:textColorHint="#847F73"
                android:backgroundTint="#D5CDBF" />
            <Button
                android:id="@+id/manual_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#173F3A"
                android:textColor="#FFFDF8"
                android:text="Invoer" />
        </LinearLayout>

        <EditText
            android:id="@+id/manual_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prijs per zak €"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            android:text="21,95"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/camera_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#C96F4A"
                android:textColor="#FFFDF8"
                android:text="Meet met camera" />
            <Button
                android:id="@+id/average_price_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#E8DFCF"
                android:textColor="#173F3A"
                android:text="Gem. prijs" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/length_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#C96F4A"
                android:textColor="#FFFDF8"
                android:text="Lengte" />
            <Button
                android:id="@+id/height_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#C96F4A"
                android:textColor="#FFFDF8"
                android:text="Hoogte" />
            <Button
                android:id="@+id/reset_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#E8DFCF"
                android:textColor="#173F3A"
                android:text="Reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oppervlakte: -&#10;Zakken: -&#10;Prijs per zak: -&#10;Totaalprijs: -"
            android:textColor="#FFFDF8"
            android:textSize="18sp"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:background="#173F3A" />

        <EditText
            android:id="@+id/wall_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Naam van deze muur"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#173F3A"
            android:textColor="#FFFDF8"
            android:text="Meting opslaan" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#FFFDF8"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#173F3A"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />
        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#173F3A"
            android:textColor="#FFFDF8"
            android:text="Startpagina" />
        <Button
            android:id="@+id/saved_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C96F4A"
            android:textColor="#FFFDF8"
            android:text="Opgeslagen metingen" />
        <Button
            android:id="@+id/account_details_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Accountgegevens" />
        <Button
            android:id="@+id/logout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Uitloggen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/saved_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#FFFDF8"
        android:visibility="gone">
        <Button
            android:id="@+id/saved_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Terug" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opgeslagen metingen"
            android:textColor="#173F3A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingTop="18dp"
            android:paddingBottom="14dp" />
        <LinearLayout
            android:id="@+id/saved_measurements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#FFFDF8">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voegmaatje"
            android:textColor="#173F3A"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inloggen"
            android:textColor="#847F73"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="22dp" />
        <EditText android:id="@+id/login_username_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Gebruikersnaam" android:inputType="textCapSentences" android:textColor="#173F3A" android:textColorHint="#847F73" android:backgroundTint="#D5CDBF" />
        <EditText android:id="@+id/login_password_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Wachtwoord" android:inputType="textPassword" android:autofillHints="password" android:textColor="#173F3A" android:textColorHint="#847F73" android:backgroundTint="#D5CDBF" />
        <CheckBox android:id="@+id/show_login_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wachtwoord tonen" android:textColor="#173F3A" />
        <CheckBox android:id="@+id/remember_checkbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingelogd blijven (6 maanden)" android:textColor="#173F3A" />
        <TextView android:id="@+id/account_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C96F4A" android:textSize="12sp" android:paddingTop="8dp" />
        <Button android:id="@+id/login_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#173F3A" android:textColor="#FFFDF8" android:text="Inloggen" />
        <Button android:id="@+id/forgot_password_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#E8DFCF" android:textColor="#173F3A" android:text="Wachtwoord vergeten" />
        <Button android:id="@+id/open_create_account_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#C96F4A" android:textColor="#FFFDF8" android:text="Account maken" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/account_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#FFFDF8">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voegmaatje"
            android:textColor="#173F3A"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maak je account aan"
            android:textColor="#847F73"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="22dp" />
        <EditText
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gebruikersnaam"
            android:inputType="textCapSentences"
            android:autofillHints="username"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />
        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wachtwoord"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />
        <CheckBox android:id="@+id/show_account_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wachtwoord tonen" android:textColor="#173F3A" />
        <EditText
            android:id="@+id/email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mailadres"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />
        <TextView
            android:id="@+id/create_account_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C96F4A"
            android:textSize="12sp"
            android:paddingTop="8dp" />
        <Button
            android:id="@+id/create_account_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C96F4A"
            android:textColor="#FFFDF8"
            android:text="Account maken" />
        <Button android:id="@+id/back_to_login_from_create_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#E8DFCF" android:textColor="#173F3A" android:text="Terug naar inloggen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/forgot_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#FFFDF8"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wachtwoord vergeten"
            android:textColor="#173F3A"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/forgot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vul je e-mailadres in om een resetlink aan te vragen."
            android:textColor="#847F73"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp" />
        <EditText
            android:id="@+id/forgot_email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mailadres"
            android:inputType="textEmailAddress"
            android:textColor="#173F3A"
            android:textColorHint="#847F73"
            android:backgroundTint="#D5CDBF" />
        <Button
            android:id="@+id/request_reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C96F4A"
            android:textColor="#FFFDF8"
            android:text="Resetlink aanvragen" />
        <Button
            android:id="@+id/request_username_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Gebruikersnaam vergeten" />
        <Button
            android:id="@+id/back_to_login_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8DFCF"
            android:textColor="#173F3A"
            android:text="Terug naar inloggen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/account_details_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#FFFDF8"
        android:visibility="gone">
        <Button android:id="@+id/account_details_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#E8DFCF" android:textColor="#173F3A" android:text="Terug" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Accountgegevens" android:textColor="#173F3A" android:textSize="28sp" android:textStyle="bold" android:paddingTop="18dp" />
        <TextView android:id="@+id/account_details_current" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#847F73" android:textSize="14sp" android:paddingTop="10dp" android:paddingBottom="18dp" />
        <EditText android:id="@+id/change_email_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nieuw e-mailadres" android:inputType="textEmailAddress" android:textColor="#173F3A" android:textColorHint="#847F73" android:backgroundTint="#D5CDBF" />
        <EditText android:id="@+id/change_password_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nieuw wachtwoord" android:inputType="textPassword" android:textColor="#173F3A" android:textColorHint="#847F73" android:backgroundTint="#D5CDBF" />
        <CheckBox android:id="@+id/show_change_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wachtwoord tonen" android:textColor="#173F3A" />
        <TextView android:id="@+id/account_details_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C96F4A" android:textSize="12sp" android:paddingTop="8dp" />
        <Button android:id="@+id/update_account_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#C96F4A" android:textColor="#FFFDF8" android:text="Gegevens wijzigen" />
    </LinearLayout>
</FrameLayout>
